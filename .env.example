NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_PATH=./data/kerb.db
UPLOADS_PATH=./data

AUTH_SECRET=dev-kerb-auth-secret-change-before-production-32bytes
AUTH_TRUSTED_ORIGINS=http://localhost:3000
QUOTE_SIGNING_KEY=dev-kerb-quote-signing-key-change-in-production-32b
LICENCE_ENC_KEY_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LICENCE_ENC_ACTIVE_VERSION=1

PAYMENT_PROVIDER=fake
MAIL_PROVIDER=console
MAIL_FROM="Kerb Desk <desk@kerb.local>"

DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
